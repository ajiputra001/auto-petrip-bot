# ══════════════════════════════════════════
# 🛡️ AUTO-PETRIP BOT v2.0 — KONFIGURASI UTAMA
# ══════════════════════════════════════════

# ── WhatsApp Target ──
WA_ADMIN=628xxxxxx@c.us
WA_GRUP=1203xxxxxx@g.us

# ── Google Form URL ──
FORM_URL=https://docs.google.com/forms/d/e/xxx/viewform

# ── Jadwal Cron Absen Otomatis ──
CRON_SCHEDULE=0 8 * * *
CRON_TIMEZONE=Asia/Jakarta

# ── Browser Config ──
BROWSER_TIMEOUT=180000
FORM_TIMEOUT=50000
MAX_RETRY=3

# ── Web Dashboard (Login Driver & Top-up) ──
# Port server web. Isi 0 untuk menonaktifkan dashboard.
WEB_PORT=3000
# URL publik dashboard (untuk webhook & link top-up). Wajib HTTPS untuk webhook production.
PUBLIC_BASE_URL=https://autobot.ajiputra.my.id
# Secret untuk tanda tangan JWT login. GANTI DENGAN STRING ACAK PANJANG!
JWT_SECRET=ubah-ini-dengan-string-acak-panjang-dan-rahasia

# ── Admin (bootstrap saat pertama kali) ──
ADMIN_EMAIL=admin@autopetrip.id
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Agung (Admin)

# ── Payment Gateway: AutoGoPay (QRIS) ──
# API Key dari dashboard AutoGoPay (https://autogopay.site)
AUTOGOPAY_API_KEY=agp_API_KEY_KAMU
# Minimal nominal top-up (rupiah)
TOPUP_MIN=10000
# Maksimal nominal top-up (rupiah)
TOPUP_MAX=10000000
# Biaya admin (%) yang ditambahkan ke nominal top-up (0 = tanpa biaya)
TOPUP_FEE_PERCENT=0
# Harga (saldo) yang dipotong setiap 1x proses pengisian form (pay as you go) = Rp 500
PRICE_PER_ABSEN=500

# ── Limit Top-up (Anti-Abuse / mencegah akun payment terblokir) ──
TOPUP_MAX_PENDING=1    # max order belum dibayar per user
TOPUP_MAX_DAILY=10     # max topup berhasil per hari per user
TOPUP_COOLDOWN_MIN=5   # jeda minimal antar pembuatan QRIS (menit)
